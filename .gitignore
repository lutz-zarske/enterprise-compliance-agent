# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Konfiguration & Secrets
.env
.env.local

# Persistierte Daten und hochgeladene Dokumente (können PII enthalten!)
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/uploads/*
# Fernet-Schlüssel für verschlüsselte Provider-Keys – niemals committen!
data/.settings.key
# Ed25519-Schlüssel der System-Signatur (Prüfdatenpakete) – niemals committen!
data/.signing.key
*.key
# SQLite-Sicherungen des Release-Assistenten (vollständige Datenbank inkl. PII)
data/backups/
# Tageszähler des Cloud-Budgets (Laufzeitdaten)
data/ai_usage.json
!data/uploads/.gitkeep

# IDE / OS
.idea/
.vscode/
.claude/
.DS_Store
Thumbs.db

# Frontend
frontend/node_modules/
frontend/.next/
frontend/out/

# Lokale Starter-Laufzeitdateien und Logs
.run/

# Lokale Agent- und Design-Richtlinien (nicht öffentlich)
DESIGN.md
CLAUDE.md
