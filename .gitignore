# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Konfiguration & Secrets
.env
.env.local

# Persistierte Daten und hochgeladene Dokumente (koennen PII enthalten!)
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/uploads/*
# Fernet-Schluessel fuer verschluesselte Provider-Keys - niemals committen!
data/.settings.key
# Ed25519-Schluessel der System-Signatur (Pruefdatenpakete) - niemals committen!
data/.signing.key
!data/uploads/.gitkeep

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Frontend
frontend/node_modules/
frontend/.next/
frontend/out/


# Lokale Claude-Desktop-Startkonfiguration (maschinenspezifisch)
.claude/launch.json

# Lokale Starter-Laufzeitdateien und Logs
.run/
