# ---------------------------------------------------------------------------
# Enterprise Compliance Agent - Beispielkonfiguration
# Kopieren nach ".env" und bei Bedarf anpassen. Alle Werte haben sichere
# Defaults; die Anwendung startet auch komplett ohne .env-Datei.
# ---------------------------------------------------------------------------

# --- Anwendung --------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# Zugriffsschutz: Bleibt API_KEY leer, ist die Authentifizierung deaktiviert
# (lokaler Betrieb). Sobald ein Wert gesetzt ist, verlangen alle Endpunkte
# ausser /health den Header "X-API-Key". Produktiv immer setzen.
API_KEY=

# --- Persistenz -------------------------------------------------------------
# SQLite ist der Default (keine Netzwerkabhaengigkeit).
# PostgreSQL: DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/compliance
DATABASE_URL=sqlite:///data/agent.db

UPLOAD_DIR=data/uploads
MAX_UPLOAD_BYTES=20971520

# --- KI-Inferenz lokal (Ollama) --------------------------------------------
# 127.0.0.1 statt localhost: Windows loest localhost bevorzugt nach ::1 (IPv6) auf;
# der Umweg kostet rund 2 s je Anfrage. "localhost" wird intern automatisch ersetzt.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b-instruct
OLLAMA_TIMEOUT_SECONDS=300
# 32k Kontext fuer lange Vertraege; mit OLLAMA_FLASH_ATTENTION=1 und
# OLLAMA_KV_CACHE_TYPE=q8_0 passt ein 14B-Modell in 16 GB Grafikspeicher.
OLLAMA_NUM_CTX=32768
OLLAMA_TEMPERATURE=0.0

# Maximale Zeichenzahl des Dokumenttextes, die an das Modell uebergeben wird.
MAX_PROMPT_CHARS=24000

# --- KI-Inferenz Cloud (optional, immer ueber das Privacy Gateway) ----------
# Startmodus: local | gemini | anthropic | openai (zur Laufzeit im UI aenderbar).
INFERENCE_MODE=local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
CLOUD_TIMEOUT_SECONDS=180

# --- Ausfallsicherheit ------------------------------------------------------
# Wiederholungen derselben Stufe bei HTTP 408/429/5xx, Verbindungsfehler oder
# Zeitueberschreitung (Sekunden, kommagetrennt), bevor die naechste Stufe der
# Kaskade uebernimmt. Ausweichmodell und Ausweich-Schluessel im UI einstellen.
LLM_RETRY_DELAYS=2,5
# Scheitern alle KI-Stufen, schliesst das deterministische Regelwerk die
# Pruefung gekennzeichnet ab (UI und Ledger). false = Fehler sichtbar lassen.
HEURISTIC_FALLBACK=true
# Optionales Tagesbudget fuer Cloud-Tokens (eigener Schluessel); -1 = ohne Limit.
CLOUD_DAILY_TOKEN_LIMIT=-1

# --- Hintergrund-Jobs -------------------------------------------------------
# Gleichzeitige Analysen (lokales Modell: 1; reine Cloud-Kaskade vertraegt mehr).
ANALYSIS_WORKERS=1
JOB_RETENTION_SECONDS=3600

# Ollama aus der Oberflaeche starten/stoppen nur direkt am Server (localhost).
LOCAL_AI_CONTROL_LOCAL_ONLY=true

# --- Datenschutz ------------------------------------------------------------
# Wenn true, werden PII-Treffer nur maskiert persistiert (z. B. "DE89****1234").
MASK_PII_IN_STORAGE=true

# Maskierungsstufe der Textansicht: strict | standard | audit_only
PII_STRICTNESS=standard

# Fernet-Schluessel fuer im UI hinterlegte API-Keys. Leer = data/.settings.key
# wird erzeugt. Produktiv aus einem Secret-Store setzen, z. B.:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEY=

# --- Logging ----------------------------------------------------------------
# JSON-Logs (eine Zeile = ein JSON-Objekt, inkl. request_id). false = Textformat.
LOG_JSON=true

# --- Rate-Limiting (Token-Bucket je Client-IP, Anfragen pro Minute) ---------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_UPLOAD_PER_MINUTE=30
RATE_LIMIT_EXTRACT_PER_MINUTE=10
RATE_LIMIT_COPILOT_PER_MINUTE=20
RATE_LIMIT_SETTINGS_PER_MINUTE=30
RATE_LIMIT_VIES_PER_MINUTE=30
RATE_LIMIT_REDACT_PER_MINUTE=120

# DLP-Gateway (/api/v1/redact): zusaetzliche Sperrbegriffe, kommagetrennt
DLP_TERMS=

# Release-Assistent: Git-Arbeitskopie (leer = Projektwurzel); Updates nur von localhost
RELEASE_REPO_DIR=
RELEASE_UPDATE_LOCAL_ONLY=true

# --- USt-IdNr.-Pruefung (VIES, Europaeische Kommission, ohne API-Key) -------
# Uebertragen werden nur Laendercode und Nummer; Ergebnis wird nicht gespeichert.
VIES_TIMEOUT_SECONDS=3
